# Copy to .env. This file is read by server.py and launch_claude.py.
# Local diagnostic server (loopback only; no admin permission required).
SELFCHECK_HOST=127.0.0.1
SELFCHECK_PORT=18765
# Expected values are comparison targets; they do not change Windows/browser settings.
SELFCHECK_EXPECTED_TIMEZONE=Asia/Tokyo
SELFCHECK_EXPECTED_LANGUAGES=ja,en
SELFCHECK_STUN_URL=stun:stun.l.google.com:19302
SELFCHECK_RTC_TIMEOUT_MS=10000
# Optional Claude Code launcher. Fill your own working HTTP proxy address.
# Example: CLAUDE_PROXY_URL=http://127.0.0.1:7897
CLAUDE_PROXY_URL=
CLAUDE_NO_PROXY=localhost,127.0.0.1,::1
CLAUDE_TZ=Asia/Tokyo
